{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scrooge-bank.example/schemas/transaction-replay-page-v1.schema.json",
  "title": "Client Health Transaction Replay Page V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "items", "nextCursor"],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "items": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/matchedTransaction"
      }
    },
    "nextCursor": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "opaqueIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "matchedTransaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transactionId",
        "clientId",
        "accountId",
        "type",
        "amount",
        "currency",
        "transactionDate",
        "status",
        "activityKind",
        "sourceFingerprint"
      ],
      "properties": {
        "transactionId": {
          "$ref": "#/$defs/opaqueIdentifier"
        },
        "clientId": {
          "$ref": "#/$defs/opaqueIdentifier"
        },
        "accountId": {
          "$ref": "#/$defs/opaqueIdentifier"
        },
        "type": {
          "enum": ["Deposit", "Withdrawal"]
        },
        "amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "transactionDate": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": ["Completed", "Pending", "Failed"]
        },
        "activityKind": {
          "enum": ["CustomerInitiated", "Automated", "Unknown"]
        },
        "sourceFingerprint": {
          "oneOf": [
            {
              "$ref": "#/$defs/opaqueIdentifier"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
