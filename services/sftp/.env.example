# IDs used for the local SFTP account and producer schedule.
SFTP_UID=1000
SFTP_GID=1000
PUBLISH_INTERVAL_SECONDS=30

# Local PostgreSQL credentials used by the application and test runner.
POSTGRES_DB=transactions
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_PORT=5437

# Poller settings. SFTP_KEY_FILE is a host path used by `make poller`.
SFTP_KEY_FILE=/absolute/path/to/id_rsa
SFTP_HOST_KEY_FINGERPRINT=SHA256:replace-with-the-fingerprint-from-ssh-keyscan
SFTP_ADDR=sftp:22
SFTP_USER=reportuser
SFTP_REMOTE_DIR=/reports
SFTP_POLL_INTERVAL=30s

# Transaction audit queue. Leave AUDIT_QUEUE_URL empty to disable SQS auditing.
# AWS credentials are supplied by the AWS SDK credential chain (for example, an IAM role).
AWS_REGION=ap-southeast-1
AUDIT_QUEUE_URL=
# Set only for a local SQS-compatible endpoint such as LocalStack.
AWS_ENDPOINT_URL=
# Optional local credentials; prefer an IAM role when running in AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Linking imported transactions to accounts (ADR-0037). The poller signs in to
# account-service with its own Cognito app client (client-credentials grant).
# Never commit the real secret; .env is gitignored.
ACCOUNT_SERVICE_BASE_URL=http://host.docker.internal:8083
COGNITO_TOKEN_URL=https://<your-domain>.auth.<region>.amazoncognito.com/oauth2/token
COGNITO_INGEST_CLIENT_ID=
COGNITO_INGEST_CLIENT_SECRET=
COGNITO_INGEST_SCOPE=crm-accounts/lookup
