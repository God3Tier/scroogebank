# Leave blank for same-origin deployments and the local Vite /api proxy.
VITE_API_URL=
# Enables local synthetic alert fixtures without contacting a backend or AWS.
VITE_USE_SYNTHETIC_ALERTS=false
# Cognito sign-in (README, "Sign-in"). None of these is a secret.
# The user pool's issuer: https://cognito-idp.<region>.amazonaws.com/<pool-id>
VITE_COGNITO_AUTHORITY=
# The CRM app client, the same one the services check as COGNITO_APP_CLIENT_ID.
VITE_COGNITO_CLIENT_ID=
# The user pool domain: https://<prefix>.auth.<region>.amazoncognito.com
VITE_COGNITO_DOMAIN=
# "true" when the user pool's MFA is optional and enforced by the token-scope
# trigger (ADR-0076): the app then enrols a TOTP authenticator itself.
VITE_MFA_ENROLMENT=
