# Copy to staging.tfvars (git-ignored). Apply the CRM stack first: this stack
# reads that stack's dashboard_inputs output from its state (ADR-0047).

legal_entity = "sg"
environment  = "staging"

# The bootstrap stack's state_bucket output.
state_bucket = "crm-tfstate-123456789012"

# The tag you pushed dashboard-service with.
image_tag = "replace-with-the-pushed-tag"
