# Copy to prod.tfvars (git-ignored). Values come from the CRM stack's outputs
# (terraform -chdir=../crm output).

environment = "prod"

allowed_cidrs         = ["203.0.113.10/32"] # nat_public_ips, each as /32
crm_ingest_public_key = "ssh-ed25519 AAAA... "  # sftp_client_public_key

# A host key you were given, kept in the git-ignored secrets/ folder at the
# repository root. Left unset, Terraform generates one.
# host_key_file = "../../../../secrets/sftp_host_key"

# producer_image = "123456789012.dkr.ecr.ap-southeast-1.amazonaws.com/core-banking-sftp-prod/producer:<tag>"
# The producer's accounts are not set here: scripts/sync-producer-accounts.sh
# copies them from the CRM (ADR-0045).
