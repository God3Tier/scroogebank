# Copy to staging.tfvars (git-ignored) and fill in. Staging is created for a
# promotion test and destroyed afterwards (ADR-0029): single-AZ, one NAT
# gateway, Fargate Spot, no WAF, no AWS Backup.

legal_entity = "sg"
environment  = "staging"

# Leave false; start a test with -var running=true.
running = false

# The tag you pushed every image with (runbook step 5).
image_tag = "replace-with-the-pushed-tag"

# Mailboxes you can read: Cognito e-mails the root admin's temporary password,
# and AWS e-mails the alarm subscription link.
root_admin_email = "you+crm-root-staging@example.edu"
alarm_email      = "you@example.edu"

# The domain you registered in Route 53 (runbook step 1): staging is then at
# https://sg-staging.<domain>, beside prod's https://sg.<domain>.
# domain_name = "example.com"

# dashboard-service's task role, from the business-dashboard stack (ADR-0047).
# Put in your account ID.
extra_audit_producer_role_arns = ["arn:aws:iam::123456789012:role/crm-sg-staging-dashboard-service-task"]

# Optional while testing the frontend from Vite against the staging user pool.
local_dev_origins = ["http://localhost:5173"]
