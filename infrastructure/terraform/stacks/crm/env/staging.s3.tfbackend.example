# Copy to staging.s3.tfbackend and use with:
#   terraform init -backend-config=env/staging.s3.tfbackend
# bucket is the bootstrap stack's state_bucket output.

bucket       = "crm-tfstate-123456789012"
key          = "crm/sg/staging.tfstate"
region       = "ap-southeast-1"
encrypt      = true
use_lockfile = true
