# Copy to prod.tfvars (git-ignored) and fill in. Synthetic client data only.

legal_entity = "sg"
environment  = "prod"

# true only in the high-availability demo week (ADR-0029).
high_availability = false

# Leave false: the stack stays stopped (0 tasks, schedules paused, no NAT
# gateway). Start a session with: terraform apply -var-file=env/prod.tfvars -var running=true
running = false

# The tag you pushed every image with (runbook step 5), for example the commit
# SHA. Until then the value does not matter: no task starts while running = false.
image_tag = "replace-with-the-pushed-tag"

# Mailboxes you can read. Cognito e-mails the root admin's temporary password
# to root_admin_email, and AWS e-mails a subscription link to alarm_email.
# Choose root_admin_email before the first start: changing it later creates a
# second root admin.
root_admin_email = "you+crm-root@example.edu"
alarm_email      = "you@example.edu"

# The project account's domain (runbook "Register a domain"): the app is at
# https://sg.itsag3t6.com and the internal ALB listens on HTTPS. Runbook
# step 3 rewrites this line, and removes it in an account without this
# domain's hosted zone, such as a personal one: the app then keeps its
# *.cloudfront.net address and the ALB listens on HTTP inside the VPC.
domain_name = "itsag3t6.com"

# dashboard-service's task role, from the business-dashboard stack (ADR-0047).
# The name is fixed, so set it before that stack exists; it refuses to plan
# until this list has it. Runbook step 3 writes this line with your account ID.
extra_audit_producer_role_arns = ["arn:aws:iam::123456789012:role/crm-sg-prod-dashboard-service-task"]

# Runbook step 9.3 writes these four lines once the sftp-server stack exists,
# replacing older copies. Leave them out until then: the ingest Lambda needs
# the SFTP server's address and host key, so the first apply cannot create it.
# enable_ingest_lambda      = true
# ingest_lambda_zip         = "../../../../services/sftp/receiver/dist/transaction-ingest.zip"
# sftp_server_address       = "203.0.113.10:22"
# sftp_host_key_fingerprint = "SHA256:..."
