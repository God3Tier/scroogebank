# The project CA (ADR-0021 decision 7: TLS end to end with a CA generated by
# Terraform, avoiding AWS Private CA costs). Each service that serves TLS gets
# a certificate for the name its callers use. Private keys are kept in
# Secrets Manager for the tasks, and also in the Terraform state, which is
# why the state bucket is encrypted and restricted (ADR-0042 decision 5).

resource "tls_private_key" "ca" {
  algorithm   = "ECDSA"
  ecdsa_curve = "P256"
}

resource "tls_self_signed_cert" "ca" {
  private_key_pem = tls_private_key.ca.private_key_pem

  subject {
    common_name  = "${local.name} project CA"
    organization = "Scrooge Global Bank CRM (CS301)"
  }

  is_ca_certificate     = true
  validity_period_hours = 24 * 365 * 2
  early_renewal_hours   = 24 * 30
  allowed_uses          = ["cert_signing", "crl_signing", "digital_signature"]
}

locals {
  # Services that serve TLS, and the names their callers use. The internal ALB
  # does not check its targets' certificates, so event-alert-service, which
  # only the ALB calls, has no Service Connect name and takes its own.
  tls_services = {
    user    = [local.sc.user]
    client  = [local.sc.client]
    account = [local.sc.account]
    auditor = [local.sc.auditor]
    alerts  = ["event-alert-service"]
  }
}

resource "tls_private_key" "service" {
  for_each    = local.tls_services
  algorithm   = "ECDSA"
  ecdsa_curve = "P256"
}

resource "tls_cert_request" "service" {
  for_each        = local.tls_services
  private_key_pem = tls_private_key.service[each.key].private_key_pem
  dns_names       = each.value

  subject {
    common_name = each.value[0]
  }
}

resource "tls_locally_signed_cert" "service" {
  for_each              = local.tls_services
  cert_request_pem      = tls_cert_request.service[each.key].cert_request_pem
  ca_private_key_pem    = tls_private_key.ca.private_key_pem
  ca_cert_pem           = tls_self_signed_cert.ca.cert_pem
  validity_period_hours = 24 * 365
  early_renewal_hours   = 24 * 30
  allowed_uses          = ["digital_signature", "key_encipherment", "server_auth"]
}

resource "aws_secretsmanager_secret" "service_tls" {
  for_each                = local.tls_services
  name                    = "${local.name}/tls/${each.key}"
  description             = "TLS certificate and key for ${each.value[0]}"
  recovery_window_in_days = local.deletion_protection ? 7 : 0
}

resource "aws_secretsmanager_secret_version" "service_tls" {
  for_each  = local.tls_services
  secret_id = aws_secretsmanager_secret.service_tls[each.key].id
  secret_string = jsonencode({
    cert = tls_locally_signed_cert.service[each.key].cert_pem
    key  = tls_private_key.service[each.key].private_key_pem
  })
}
