# Copy to staging.tfvars (git-ignored). Apply the CRM stack first: this stack
# reads that stack's alerts_worker_inputs output from its state (ADR-0048).

legal_entity = "sg"
environment  = "staging"

# The bootstrap stack's state_bucket output.
state_bucket = "crm-tfstate-123456789012"

# Both stay false until the Tavily secret is populated, the live search
# benchmark has passed and the AI benchmark gates are met.
ingestion_enabled = false
ai_enabled        = false
