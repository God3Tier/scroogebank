# Copy to prod.tfvars (git-ignored). Apply the CRM stack first: this stack reads
# that stack's alerts_worker_inputs output from its state (ADR-0048). The worker
# uses the same image and tag as the event-alert-service API. Its schedule
# follows the CRM stack's running variable, so apply this stack again after
# every CRM apply that changes it.

legal_entity = "sg"
environment  = "prod"

# The bootstrap stack's state_bucket output, the same bucket as in
# env/prod.s3.tfbackend.
state_bucket = "crm-tfstate-123456789012"

# Both stay false until the Tavily secret is populated, the live search
# benchmark has passed and the AI benchmark gates are met.
ingestion_enabled = false
ai_enabled        = false

# Keep empty until the source register records an approved commercial-publisher
# terms review. Official issuer/exchange/regulator domains come from alerts-db.
approved_news_domains = []
