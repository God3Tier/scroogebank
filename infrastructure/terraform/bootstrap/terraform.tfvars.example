# Copy to terraform.tfvars (git-ignored).

# Home region. Learner Lab (voclabs) only allows us-east-1 and us-west-2.
aws_region = "us-east-1"

free_plan     = false
budget_emails = ["crm-budget@example.test"]

# The first day the project could spend on this account; crm-total counts
# everything from here against the USD 300 limit.
budget_start_date = "2026-09-01"
