{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scrooge:event-driven-alerts:ai-benchmark-run:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["model", "promptVersion", "estimatedCostUsd", "observations"],
  "properties": {
    "model": {"type": "string", "minLength": 1},
    "promptVersion": {"type": "string", "minLength": 1},
    "estimatedCostUsd": {"type": "number", "minimum": 0},
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["exampleId", "predictedType", "accepted", "safetyPassed", "citationsPassed", "adviceGuardPassed", "modelInvoked", "stopReason", "inputTokens", "outputTokens", "latencyMillis"],
        "properties": {
          "exampleId": {"type": "string", "minLength": 1},
          "predictedType": {"type": ["string", "null"], "enum": ["EARNINGS", "REGULATORY", "CORPORATE_ACTION", "CREDIT", "LEADERSHIP", "MACRO", "OTHER", null]},
          "accepted": {"type": "boolean"},
          "safetyPassed": {"type": "boolean"},
          "citationsPassed": {"type": "boolean"},
          "adviceGuardPassed": {"type": "boolean"},
          "modelInvoked": {"type": "boolean"},
          "stopReason": {"type": "string", "minLength": 1},
          "inputTokens": {"type": "integer", "minimum": 0},
          "outputTokens": {"type": "integer", "minimum": 0},
          "latencyMillis": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
